# Database (Neon Postgres — schéma `seostats` de la base partagée avec invoices)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Auth (Better Auth)
BETTER_AUTH_SECRET=xxx
BETTER_AUTH_URL=https://hubseo.jonlabs.ch
# Optional : URLs supplementaires acceptees (comma-separated) si tu accedes au hub via plusieurs domaines
BETTER_AUTH_TRUSTED_ORIGINS=https://jlabs-content-hub.vercel.app,https://hubseo.jonlabs.ch

# Auth machine — ne stocker que sha256(secret), jamais le bearer brut.
# Bearer envoyé : <id>.<secret>. La rotation chevauche deux entrées actives ; revokedAt révoque immédiatement.
MACHINE_CREDENTIALS_JSON=[{"id":"hermes-2026-08","tokenHash":"<sha256-hex>","scopes":["projects:read","projects:write","content:read","content:write"],"expiresAt":"2026-09-01T00:00:00.000Z"}]

# Credential Hermes isolé : cette map est fusionnée avec MACHINE_CREDENTIALS_JSON
# sans jamais l'écraser. Le bearer brut vit uniquement dans le profil Hermes ;
# projects est obligatoire pour `agent:insights:read` et borne la lecture par slug.
# Exemple combiné Insights + avis Barber Concept (hash seulement ; le bearer brut reste sur le VPS) :
# HERMES_MACHINE_CREDENTIALS_JSON=[{"id":"hermes-barberconcept-YYYY-MM","tokenHash":"<sha256-hex>","scopes":["agent:insights:read","review:read","review:propose","review:publish","review:report:read"],"projects":["barberconcept"],"expiresAt":"<ISO-8601>"}]

# Reconciler core contrôlé (serveur uniquement) — requis pour créer une projection SEO inconnue.
CORE_RECONCILER_URL=https://internal.example/api/core/entities/reconcile
CORE_RECONCILER_TOKEN=xxx

# Chiffrement (secrets stockés : CMS, indexation) — 32 bytes hex
ENCRYPTION_KEY=xxx

# App
PUBLIC_APP_URL=https://hubseo.jonlabs.ch

# Notifications email (Resend) — FROM_EMAIL doit etre sur un domaine verifie dans Resend
RESEND_API_KEY=re_xxx
ADMIN_EMAIL=contact@jonlabs.ch
FROM_EMAIL=hub@factures.jonlabs.ch

# Cron (Vercel envoie automatiquement Bearer ${CRON_SECRET} sur les routes /api/cron/*)
CRON_SECRET=xxx

# Observabilité (OPS-001) — niveau de log : debug | info | warn | error (défaut info)
# LOG_LEVEL=info

# Feature flags de migration (GOV-005) — tous OFF par défaut.
# Activer une verticale sur un canary : FLAG_<NOM>=true
# Flags disponibles : JOBS_V2, FINDINGS, INDEXNOW, PLAUSIBLE, TELEGRAM, AGENT_RUNNER
# INDEXNOW = interrupteur maître des soumissions auto aux moteurs (IndexNow + Google Indexing API
# éligible JobPosting/BroadcastEvent, IDX-008). OFF (défaut) => aucune soumission ne part.
# FLAG_INDEXNOW=true

# Fan-out SEO hebdomadaire vers Agent Ops/Hermes (OFF tant que receiver/VPS n'est pas vérifié).
# Le secret est partagé avec AGENT_OPS_SEO_WEBHOOK_SECRET côté VPS.
# Commencer par le canary physiopommier, puis élargir progressivement.
# ⚠️ Le credential `monitor:read` qu'Agent Ops utilise pour lire
#    /api/agent/reports/{slot}/projects/{slug} DOIT porter une allowlist `projects` :
#    la route borne désormais la lecture au slug déclaré, et un credential sans
#    allowlist reçoit 403 sur tous les slugs.
# FLAG_AGENT_RUNNER=true
# HERMES_SEO_WEBHOOK_URL=https://agent.example/webhooks/seo-weekly
# HERMES_SEO_WEBHOOK_SECRET=xxx
# SEO_AGENT_PROJECT_ALLOWLIST=physiopommier
# Allowlist code complète actuelle (lecureux et bisrepetita n'ont pas de repo éditable) :
# barberconcept,barbermedia,cardrank,jonlabs,physiopommier,spinlink,wildcat
